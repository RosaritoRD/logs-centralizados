//  Alloy: collects the logs and hands them to Loki.
//
// Two sources, the two halves of the problem:
//
//   1. THE CONTAINERS (n8n, the API, nginx, the acquisition workers).
//   2. THE HOST (auth.log, xrdp.log, fail2ban.log, syslog, ufw.log). These tell
//      you who is knocking on the machine, and they live outside any container.
//
// Alloy mounts /var/log, /var/lib/docker/containers and the Docker socket
// READ-ONLY. It cannot write to any of the three.

logging {
  level  = "warn"
  format = "logfmt"
}

// ── 1. containers ─────────────────────────────────────────────────────────
//
// WHY WE READ THE FILES INSTEAD OF USING `loki.source.docker`
//
// The obvious choice is `loki.source.docker`, which asks the Docker API for the
// logs. We tried it and it has a problem that never goes away: when a container
// is DELETED (which happens on EVERY deploy of the website), its tailer keeps
// asking for it every five seconds and logs
//
//   level=error msg="error inspecting Docker container" ... No such container
//
// forever. Filtering discovery to running containers wasn't enough: the tailer
// doesn't depend on discovery. Upgrading Alloy from v1.5.1 to v1.18.1 slowed it
// down, but it kept happening, with four dead containers on the list at once.
//
// Asking an API about something deleted will always fail. A FILE that
// disappears, on the other hand, handles itself: the tailer loses its source
// and goes quiet. Docker writes with the json-file driver, so the logs are
// already on disk; we read them from there.
//
// Docker discovery is kept ONLY to know each container's name: the file is
// named after its id, and "website" reads much better than "74770e262a0f…".
discovery.docker "containers" {
  host             = "unix:///var/run/docker.sock"
  // 5 s, not 30 s: short `docker compose run --rm` runs (under 30 s) were
  // discovered after their container was already gone, and Alloy skipped them
  // with "failed to create source": ~26 runs a day without a single log line.
  // Polling the local socket every 5 s costs nothing.
  refresh_interval = "5s"

  filter {
    name   = "status"
    values = ["running"]
  }
}

discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  // Docker reports the name as "/website"; the slash gets in the way when filtering.
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }

  // The log file path, built from the container id.
  rule {
    source_labels = ["__meta_docker_container_id"]
    regex         = "(.*)"
    target_label  = "__path__"
    replacement   = "/var/lib/docker/containers/$1/$1-json.log"
  }

  // The Fleet workers are started with `docker compose run --rm`, which gives
  // EVERY run a new name: acquisition-worker-run-99ddd20ff847. Since the name
  // is the `container` label, each run opened a NEW stream in Loki. With
  // cortex-live and dvcr-live every 7 min plus packages every 15, that's ~300
  // streams a day that never repeat.
  //
  // Loki indexes by labels: thousands of one-line streams bloat the index,
  // split the data into tiny chunks and make the dashboard's container
  // dropdown useless (83 values, 70 of them junk).
  //
  // Here the -run-<hash> suffix is stripped: every run of the same worker lands
  // in ONE stream, still told apart by the line's timestamp. If the name has no
  // such suffix, the rule doesn't match and the name stays as it is.
  rule {
    source_labels = ["container"]
    regex         = "(.*)-run-[0-9a-f]{8,}"
    target_label  = "container"
    replacement   = "$1"
  }

  rule {
    target_label = "source"
    replacement  = "docker"
  }
}

loki.source.file "containers" {
  targets    = discovery.relabel.containers.output
  forward_to = [loki.process.docker.receiver]
}

// Docker's file isn't the program's line: it's one JSON object per line with
// the line inside. Without this, Loki would show the envelope, not the letter.
loki.process "docker" {
  forward_to = [loki.write.local.receiver]

  stage.json {
    expressions = {
      output = "log",
      flow   = "stream",
      ts     = "time",
    }
  }

  // The line's REAL time, not when Alloy read it. It matters on startup:
  // otherwise the whole backlog would come in stamped "right now".
  stage.timestamp {
    source = "ts"
    format = "RFC3339Nano"
  }

  stage.labels {
    values = { stream = "flow" }
  }

  stage.output {
    source = "output"
  }

  // `filename` is the path of the json.log, which contains the container id.
  // For a short-lived container it's unique per run, just like the name: the
  // same stream explosion through the back door. And it adds nothing, because
  // `container` already says whose line it is. It's dropped ONLY for
  // containers; the host files (auth.log, syslog…) don't go through here and
  // keep it, since there it's what tells them apart.
  stage.label_drop {
    values = ["filename"]
  }
}

// ── 2. host files ─────────────────────────────────────────────────────────
// The labels go INSIDE each target: loki.source.file doesn't accept its own
// `labels` block, and with one Alloy won't even start.
local.file_match "host" {
  path_targets = [
    { __path__ = "/var/log/auth.log",     job = "ssh",      source = "host" },
    { __path__ = "/var/log/xrdp.log",     job = "rdp",      source = "host" },
    { __path__ = "/var/log/fail2ban.log", job = "fail2ban", source = "host" },
    { __path__ = "/var/log/syslog",       job = "syslog",   source = "host" },
    { __path__ = "/var/log/ufw.log",      job = "firewall", source = "host" },
  ]
}

loki.source.file "host" {
  targets    = local.file_match.host.targets
  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
