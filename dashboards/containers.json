{
  "uid": "logs-containers",
  "title": "Containers",
  "description": "Container health: who is writing, who is complaining and exactly what they said. Covers the website, the API, n8n, the workers and every other project on the VPS.",
  "tags": ["server", "platform"],
  "timezone": "utc",
  "editable": false,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "container",
        "label": "Container",
        "type": "query",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": { "label": "container", "refId": "var" },
        "definition": "label_values(container)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "current": { "selected": true, "text": ["All"], "value": ["$__all"] }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Errors",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Error lines",
      "description": "Only error-LEVEL lines (level=error, ERROR:, [error]). Searching for the bare word overcounted: Grafana writes error=\"database is locked\" on info-level lines, and 23 errors showed up where there were none.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 5, "w": 8, "x": 0, "y": 1 },
      "options": {
        "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false },
        "colorMode": "value", "graphMode": "area", "textMode": "auto", "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "#E5A03D", "value": 50 },
              { "color": "#E5484D", "value": 500 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum(count_over_time({source=\"docker\", container=~\"$container\"} |~ \"(?i)(level=error|error:|\\\\[error\\\\])\" [$__range]))",
          "queryType": "instant"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Containers writing",
      "description": "If this number suddenly drops, something stopped starting.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 5, "w": 8, "x": 8, "y": 1 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "none", "graphMode": "area", "textMode": "auto", "justifyMode": "auto"
      },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "count(sum by (container) (count_over_time({source=\"docker\"} [$__range])))",
          "queryType": "instant"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Total lines",
      "description": "Log volume for the range. A jump for no reason is usually a retry loop.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 5, "w": 8, "x": 16, "y": 1 },
      "options": {
        "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false },
        "colorMode": "none", "graphMode": "area", "textMode": "auto", "justifyMode": "auto"
      },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum(count_over_time({source=\"docker\", container=~\"$container\"} [$__range]))",
          "queryType": "instant"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Errors by container",
      "description": "Who is complaining and since when. This is where you see what started failing and at what time.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 6 },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "bars", "fillOpacity": 70, "lineWidth": 1, "stacking": { "mode": "normal", "group": "A" } },
          "color": { "mode": "palette-classic" },
          "unit": "short"
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "showLegend": true, "calcs": ["sum"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{container}}",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum by (container) (count_over_time({source=\"docker\", container=~\"$container\"} |~ \"(?i)(level=error|error:|\\\\[error\\\\])\" [15m]))",
          "queryType": "range"
        }
      ]
    },
    {
      "type": "logs",
      "title": "The errors, one by one",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 11, "w": 24, "x": 0, "y": 15 },
      "options": {
        "showTime": true, "showLabels": true, "showCommonLabels": false,
        "wrapLogMessage": true, "prettifyLogMessage": false,
        "enableLogDetails": true, "dedupStrategy": "exact", "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{source=\"docker\", container=~\"$container\"} |~ \"(?i)(level=error|error:|\\\\[error\\\\])\"",
          "queryType": "range"
        }
      ]
    },
    {
      "type": "row",
      "title": "Volume",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 26 },
      "collapsed": true,
      "panels": [
        {
          "type": "timeseries",
          "title": "Lines by container",
          "description": "Everything each one writes, not just errors. Useful to spot who has gotten noisy.",
          "datasource": { "type": "loki", "uid": "loki" },
          "gridPos": { "h": 9, "w": 24, "x": 0, "y": 27 },
          "fieldConfig": {
            "defaults": {
              "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1 },
              "color": { "mode": "palette-classic" },
              "unit": "short"
            },
            "overrides": []
          },
          "options": { "legend": { "displayMode": "table", "placement": "right", "showLegend": true, "calcs": ["sum"] }, "tooltip": { "mode": "multi" } },
          "targets": [
            {
              "refId": "A",
              "legendFormat": "{{container}}",
              "datasource": { "type": "loki", "uid": "loki" },
              "expr": "sum by (container) (count_over_time({source=\"docker\", container=~\"$container\"} [15m]))",
              "queryType": "range"
            }
          ]
        }
      ]
    }
  ]
}
