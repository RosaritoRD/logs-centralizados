{
  "uid": "logs-security",
  "title": "Server security",
  "description": "Who is knocking on the server and who actually got in. The data comes from the host's /var/log, collected by Alloy.",
  "tags": ["server", "security"],
  "timezone": "utc",
  "editable": false,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": { "from": "now-24h", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    {
      "type": "row",
      "title": "What matters",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Failed passwords (SSH)",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 1 },
      "options": {
        "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false },
        "colorMode": "value", "graphMode": "area", "textMode": "auto", "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "#E5A03D", "value": 20 },
              { "color": "#E5484D", "value": 100 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum(count_over_time({source=\"host\", job=\"ssh\"} |= \"Failed password\" [$__range]))",
          "queryType": "instant"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Made-up users (SSH)",
      "description": "Someone trying names that don't exist: admin, oracle, test… It's probing, not a typo from someone who has an account.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 1 },
      "options": {
        "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false },
        "colorMode": "value", "graphMode": "area", "textMode": "auto", "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "#E5A03D", "value": 10 },
              { "color": "#E5484D", "value": 50 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum(count_over_time({source=\"host\", job=\"ssh\"} |= \"Invalid user\" [$__range]))",
          "queryType": "instant"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Remote desktop probes",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 1 },
      "options": {
        "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false },
        "colorMode": "value", "graphMode": "area", "textMode": "auto", "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "#E5A03D", "value": 20 },
              { "color": "#E5484D", "value": 100 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum(count_over_time({source=\"host\", job=\"rdp\"} |= \"connection accepted\" [$__range]))",
          "queryType": "instant"
        }
      ]
    },
    {
      "type": "stat",
      "title": "GOT IN (successful logins)",
      "description": "The only number on this screen that can mean someone is already inside. If you don't recognize one, change the password.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 1 },
      "options": {
        "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false },
        "colorMode": "background", "graphMode": "none", "textMode": "auto", "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#1FA971", "value": null },
              { "color": "#2F6BFF", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum(count_over_time({source=\"host\", job=\"ssh\"} |= \"Accepted \" [$__range]))",
          "queryType": "instant"
        }
      ]
    },
    {
      "type": "logs",
      "title": "Logins that DID work",
      "description": "Each line is someone who got in. Check the IP: if it isn't yours, it's no longer an attempt.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 6 },
      "options": {
        "showTime": true, "showLabels": false, "showCommonLabels": false,
        "wrapLogMessage": true, "prettifyLogMessage": false,
        "enableLogDetails": true, "dedupStrategy": "none", "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{source=\"host\", job=\"ssh\"} |= \"Accepted \"",
          "queryType": "range"
        }
      ]
    },
    {
      "type": "row",
      "title": "Who is knocking at the door",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Attempts per hour, by source",
      "description": "A spike here is a scan. A flat, steady line is a bot that won't give up.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 14, "x": 0, "y": 15 },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "bars", "fillOpacity": 60, "lineWidth": 1, "stacking": { "mode": "normal", "group": "A" } },
          "color": { "mode": "palette-classic" },
          "unit": "short"
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "SSH · failed password",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum(count_over_time({source=\"host\", job=\"ssh\"} |= \"Failed password\" [1h]))",
          "queryType": "range"
        },
        {
          "refId": "B",
          "legendFormat": "SSH · made-up user",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum(count_over_time({source=\"host\", job=\"ssh\"} |= \"Invalid user\" [1h]))",
          "queryType": "range"
        },
        {
          "refId": "C",
          "legendFormat": "Remote desktop",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum(count_over_time({source=\"host\", job=\"rdp\"} |= \"connection accepted\" [1h]))",
          "queryType": "range"
        }
      ]
    },
    {
      "type": "logs",
      "title": "fail2ban bans",
      "description": "Each line is an IP that crossed the line and got locked out. Activity here is a good sign: it means something is stopping them.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 10, "x": 14, "y": 15 },
      "options": {
        "showTime": true, "showLabels": false, "showCommonLabels": false,
        "wrapLogMessage": true, "prettifyLogMessage": false,
        "enableLogDetails": true, "dedupStrategy": "none", "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{source=\"host\", job=\"fail2ban\"} |~ \"Ban |Unban \"",
          "queryType": "range"
        }
      ]
    },
    {
      "type": "logs",
      "title": "Everything from the host, raw",
      "description": "SSH, remote desktop, fail2ban and firewall together. For when you already know what you're looking for.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 23 },
      "options": {
        "showTime": true, "showLabels": true, "showCommonLabels": false,
        "wrapLogMessage": true, "prettifyLogMessage": false,
        "enableLogDetails": true, "dedupStrategy": "none", "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{source=\"host\"}",
          "queryType": "range"
        }
      ]
    }
  ]
}
